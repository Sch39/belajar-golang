POST http://localhost:8080/api/products
Content-Type: application/json
Accept: application/json

{
    "name": "Sample Product",
    "price": 100,
    "stock": 0
}

###
GET http://localhost:8080/api/products
Accept: application/json

###
@PRODUCT_ID = 1c8cdc96-4999-43f5-bcb3-a93ba9c38337

###
